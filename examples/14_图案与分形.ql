# ==========================================================
#  14 用字符画图：乘法表、金字塔、谢尔宾斯基三角形、曼德勃罗集
# ==========================================================

输出("【九九乘法表】")
遍历 i 于 范围(1, 10) {
    让 行 = ""
    遍历 j 于 范围(1, i + 1) {
        行 += "${j}×${i}=${i * j}".填充(8)
    }
    输出(行)
}

输出("")
输出("【金字塔】")
让 层数 = 6
遍历 i 于 范围(1, 层数 + 1) {
    输出(" " * (层数 - i) + "*" * (2 * i - 1))
}

输出("")
输出("【菱形】")
让 半径 = 5
遍历 i 于 范围(-半径 + 1, 半径) {
    让 宽 = 半径 - abs(i)
    输出(" " * (abs(i)) + "*" * (2 * 宽 - 1))
}

输出("")
输出("【谢尔宾斯基三角形】（递归分形）")
函数 谢尔宾斯基(高度) {
    如果 高度 == 0 { 返回 ["*"] }
    让 上一 = 谢尔宾斯基(高度 - 1)
    让 结果 = []
    让 宽度 = 上一[-1].长度
    遍历 行 于 上一 {
        结果.追加(" ".填充(宽度 // 2 + 1) + 行 + " ".填充(宽度 // 2 + 1))
    }
    遍历 行 于 上一 {
        结果.追加(行 + " " + 行)
    }
    返回 结果
}
遍历 行 于 谢尔宾斯基(4) { 输出(行) }

输出("")
输出("【曼德勃罗集】（字符画）")
# 在复平面上逐点迭代 z = z² + c，看它是否发散
函数 曼德勃罗(实部, 虚部, 最大迭代=30) {
    让 zr = 0.0
    让 zi = 0.0
    遍历 k 于 范围(最大迭代) {
        让 新实 = zr * zr - zi * zi + 实部
        让 新虚 = 2 * zr * zi + 虚部
        zr = 新实
        zi = 新虚
        如果 zr * zr + zi * zi > 4 { 返回 k }
    }
    返回 最大迭代
}

常量 色阶 = " .:-=+*#%@"
让 宽 = 70
让 高 = 24
遍历 y 于 范围(高) {
    让 行 = ""
    遍历 x 于 范围(宽) {
        让 实部 = (x - 宽 * 0.65) / (宽 * 0.32)
        让 虚部 = (y - 高 * 0.5) / (高 * 0.42)
        让 次数 = 曼德勃罗(实部, 虚部)
        行 += 色阶[整数(次数 * (色阶.长度 - 1) / 30)]
    }
    输出(行)
}

输出("")
输出("【斐波那契螺旋近似图】")
# 用四个方向画正方形，边长取斐波那契数列
让 尺寸 = 21
让 画布 = []
遍历 _ 于 范围(尺寸) {
    让 行 = []
    遍历 _ 于 范围(尺寸) { 行.追加(" ") }
    画布.追加(行)
}
让 数列 = [1, 1, 2, 3, 5, 8, 13]
让 边 = 0
让 方向 = 0                      # 0右 1下 2左 3上
让 起点 = [10, 10]
遍历 n 于 数列 {
    让 r = 起点[0]
    让 c = 起点[1]
    遍历 k 于 范围(n) {
        如果 0 <= r 且 r < 尺寸 且 0 <= c 且 c < 尺寸 {
            画布[r][c] = "#"
        }
        如果 方向 == 0 { c += 1 }
        又如果 方向 == 1 { r += 1 }
        又如果 方向 == 2 { c -= 1 }
        否则 { r -= 1 }
    }
    起点 = [r, c]
    方向 = (方向 + 1) % 4
}
遍历 行 于 画布 { 输出(行.连接("")) }
