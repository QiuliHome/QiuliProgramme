# ==========================================================
#  Qiuli 脚本模板
#  新建脚本：python qiuli.py new 我的脚本
#  运行脚本：python qiuli.py 我的脚本.ql
# ==========================================================

# ---- 1. 变量 ----
让 名字 = "世界"
常量 版本号 = "1.0"

# ---- 2. 函数 ----
函数 打招呼(谁) {
    返回 "你好，${谁}！"
}

# ---- 3. 判断与循环 ----
遍历 i 于 范围(3) {
    如果 i == 1 {
        输出(打招呼(名字), "（第 ${i + 1} 次，版本 ${版本号}）")
    } 否则 {
        输出(打招呼(名字))
    }
}

# ---- 4. 列表与字典 ----
让 清单 = ["写脚本", "跑起来", "改一改"]
遍历 下标, 事项 于 清单 {
    输出("  ${下标 + 1}. ${事项}")
}

# ---- 5. 类 ----
类 计数器 {
    构造(起点=0) {
        自身.值 = 起点
    }
    加一() {
        自身.值 += 1
        返回 自身.值
    }
}
让 c = 计数器(10)
输出("计数器：", c.加一(), c.加一())

输出("✨ 模板跑通了，开始写你自己的代码吧")
