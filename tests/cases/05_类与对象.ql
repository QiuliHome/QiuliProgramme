# 用例 05：类、继承、self、super、运算符重载

类 动物 {
    让 界 = "动物界"

    构造(名字) {
        自身.名字 = 名字
    }
    介绍() => "我是${自身.名字}"
    发声() => "……"
}

类 猫 继承 动物 {
    构造(名字, 花色="橘") {
        父.init(名字)
        自身.花色 = 花色
    }
    发声() => "喵喵"
    __字符串__() => "🐱${自身.名字}(${自身.花色})"
}

让 a = 动物("无名")
断言(a.介绍() == "我是无名")
断言(a.发声() == "……")
断言(a.界 == "动物界")

让 m = 猫("咪咪")
断言(m.介绍() == "我是咪咪")      # 继承来的方法
断言(m.发声() == "喵喵")          # 重写的方法
断言(m.花色 == "橘")
断言(字符串(m) == "🐱咪咪(橘)")    # __字符串__ 生效

# 属性赋值与读取
m.年龄 = 3
断言(m.年龄 == 3)

# 实例方法可以被取出后单独用吗（不能，需要 self）——这里只验证它是方法
断言(类型(m.发声) == "方法")

# ---- 运算符重载 ----
类 向量 {
    构造(x, y) {
        自身.x = x
        自身.y = y
    }
    __加__(另一个) => 向量(自身.x + 另一个.x, 自身.y + 另一个.y)
    __减__(另一个) => 向量(自身.x - 另一个.x, 自身.y - 另一个.y)
    __乘__(倍数) => 向量(自身.x * 倍数, 自身.y * 倍数)
    __等于__(另一个) => 自身.x == 另一个.x 且 自身.y == 另一个.y
    __字符串__() => "(${自身.x}, ${自身.y})"
}
让 v1 = 向量(1, 2)
让 v2 = 向量(3, 4)
断言(字符串(v1 + v2) == "(4, 6)")
断言(字符串(v2 - v1) == "(2, 2)")
断言(字符串(v1 * 3) == "(3, 6)")
断言(v1 == 向量(1, 2))

# ---- 用类实现一个计数器 ----
类 累加器 {
    构造(起点=0) {
        自身.值 = 起点
    }
    加(n=1) {
        自身.值 += n
        返回 自身          # 返回自身以支持链式调用
    }
    取() => 自身.值
}
断言(累加器(10).加().加(5).取() == 16)

# ---- 类字段：在实例化时复制到每个实例 ----
类 配置 {
    让 版本 = "1.0"
    让 标签 = ["默认"]
    构造() {}
}
让 c1 = 配置()
让 c2 = 配置()
c1.版本 = "2.0"
断言(c1.版本 == "2.0")
断言(c2.版本 == "1.0")

# ---- 异常与方法配合 ----
类 保险箱 {
    构造(密码) { 自身.密码 = 密码  自身.打开次数 = 0 }
    打开(输入密码) {
        如果 输入密码 != 自身.密码 { 抛出 错误("密码错误") }
        自身.打开次数 += 1
        返回 真
    }
}
让 箱子 = 保险箱("1234")
断言(箱子.打开("1234"))
尝试 {
    箱子.打开("0000")
    断言(假)              # 不该执行到这里
} 捕获 e {
    断言(e.消息 == "密码错误")
}
断言(箱子.打开次数 == 1)

输出("用例 05 全部通过 ✔")
