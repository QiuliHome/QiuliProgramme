# ==========================================================
#  09 算法集锦
#  用 Qiuli 实现经典算法：排序、查找、筛法、递归、动态规划
# ==========================================================

# ---- 冒泡排序（就地排序）----
函数 冒泡排序(a) {
    让 n = a.长度
    遍历 i 于 范围(n) {
        让 交换过 = 假
        遍历 j 于 范围(n - i - 1) {
            如果 a[j] > a[j + 1] {
                让 t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
                交换过 = 真
            }
        }
        如果 非 交换过 { 中断 }
    }
    返回 a
}

# ---- 快速排序（返回新列表，函数式写法）----
函数 快排(a) {
    如果 a.长度 <= 1 { 返回 a }
    让 基准 = a[0]
    让 小的 = []
    让 大的 = []
    遍历 x 于 a[1:] {
        如果 x <= 基准 { 小的.追加(x) } 否则 { 大的.追加(x) }
    }
    返回 快排(小的) + [基准] + 快排(大的)
}

让 原始数据 = [5, 3, 8, 1, 9, 2, 7]
输出("原数据：", 原始数据)
输出("冒泡排序：", 冒泡排序(原始数据))
输出("快速排序：", 快排([5, 3, 8, 1, 9, 2, 7]))

# ---- 二分查找（要求已排序）----
函数 二分查找(a, 目标) {
    让 左 = 0
    让 右 = a.长度 - 1
    当 左 <= 右 {
        让 中 = (左 + 右) // 2
        如果 a[中] == 目标 { 返回 中 }
        如果 a[中] < 目标 { 左 = 中 + 1 } 否则 { 右 = 中 - 1 }
    }
    返回 -1
}
让 有序 = 快排([10, 3, 7, 1, 9, 22, 4])
输出("有序数组：", 有序)
输出("找 7 的下标：", 二分查找(有序, 7))
输出("找 100 的下标：", 二分查找(有序, 100))

# ---- 埃拉托斯特尼筛法：找出 n 以内的所有质数 ----
函数 质数表(n) {
    让 标记 = []
    遍历 _ 于 范围(n + 1) { 标记.追加(真) }
    标记[0] = 假
    如果 n >= 1 { 标记[1] = 假 }
    让 i = 2
    当 i * i <= n {
        如果 标记[i] {
            让 j = i * i
            当 j <= n {
                标记[j] = 假
                j += i
            }
        }
        i += 1
    }
    让 结果 = []
    遍历 k 于 范围(2, n + 1) {
        如果 标记[k] { 结果.追加(k) }
    }
    返回 结果
}
输出("50 以内的质数：", 质数表(50))

# ---- 欧几里得算法：最大公约数 ----
函数 公约数(a, b) {
    当 b != 0 {
        让 t = b
        b = a % b
        a = t
    }
    返回 a
}
输出("gcd(48, 18) =", 公约数(48, 18))

# ---- 汉诺塔（递归）----
让 步数 = 0
# 注意：「从」是 Qiuli 的关键字（用于 从…导入…），不能当变量名
函数 汉诺塔(层数, 起点, 终点, 中转) {
    如果 层数 == 0 { 返回 }
    汉诺塔(层数 - 1, 起点, 中转, 终点)
    步数 += 1
    汉诺塔(层数 - 1, 中转, 终点, 起点)
}
汉诺塔(4, "A", "C", "B")
输出("4 层汉诺塔需要", 步数, "步")

# ---- 动态规划：爬楼梯（每次 1 或 2 阶）----
函数 爬楼梯(n) {
    如果 n <= 2 { 返回 n }
    让 dp = [0, 1, 2]
    遍历 i 于 范围(3, n + 1) {
        dp.追加(dp[i - 1] + dp[i - 2])
    }
    返回 dp[n]
}
输出("10 阶楼梯有", 爬楼梯(10), "种走法")

# ---- 最长公共子序列 ----
函数 最长公共子序列(a, b) {
    让 m = a.长度
    让 n = b.长度
    让 dp = []
    遍历 _ 于 范围(m + 1) {
        让 行 = []
        遍历 _ 于 范围(n + 1) { 行.追加(0) }
        dp.追加(行)
    }
    遍历 i 于 范围(1, m + 1) {
        遍历 j 于 范围(1, n + 1) {
            如果 a[i - 1] == b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } 否则 {
                dp[i][j] = 最大(dp[i - 1][j], dp[i][j - 1])
            }
        }
    }
    返回 dp[m][n]
}
输出("'abcde' 与 'ace' 的最长公共子序列长度 =", 最长公共子序列("abcde", "ace"))

# ---- 回文判断 ----
函数 是回文(s) {
    s = s.小写()
    返回 s == 反转(s)
}
输出("'上海自来水来自海上' 是回文吗：", 是回文("上海自来水来自海上"))
输出("'level' 是回文吗：", 是回文("level"))

# ---- 计时：看看排序 5000 个数要多久 ----
导入 "时间" 作为 t
让 大数据 = []
遍历 i 于 范围(600) { 大数据.追加((i * 37) % 997) }
让 耗时 = t.计时(() => { 冒泡排序(大数据) })
输出("冒泡排序 600 个数耗时：", 耗时, "毫秒")
