# ==========================================================
#  11 小游戏：猜数字
#  电脑心里想一个 1~100 的数，你有限次机会猜中它
# ==========================================================

导入 "随机" 作为 随机库

让 答案 = 随机库.整数(1, 100)
让 最多次数 = 7
让 已猜 = 0

输出("════════════════════════════")
输出("   猜数字游戏（1 ~ 100）")
输出("   你有 ${最多次数} 次机会")
输出("════════════════════════════")

当 已猜 < 最多次数 {
    让 剩余 = 最多次数 - 已猜
    写("还剩 ${剩余} 次，请输入：")
    让 原始输入 = 输入()
    如果 原始输入 == 空 { 输出("（输入结束，游戏中止）")  中断 }

    # 输入的内容是字符串，需要转成数字；转不出来就让它重来
    让 猜测 = 数字(原始输入)
    如果 猜测 == 空 {
        输出("  「${原始输入}」不是一个数字，重新来一次～")
        继续
    }

    已猜 += 1

    如果 猜测 == 答案 {
        输出("🎉 恭喜！${已猜} 次就猜中了，答案就是 ${答案}")
        中断
    } 又如果 猜测 < 答案 {
        输出("  太小了 ↑")
    } 否则 {
        输出("  太大了 ↓")
    }

    # 最后两次给点提示
    如果 剩余 == 2 {
        输出("  提示：答案是 ${答案 % 2 == 0 ? "偶数" : "奇数"}")
    }
}

如果 已猜 == 最多次数 {
    输出("💧 机会用完了，答案是 ${答案}")
}

输出("—— 游戏结束，谢谢游玩 ——")
