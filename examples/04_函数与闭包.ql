# ==========================================================
#  04 函数：默认参数、命名参数、可变参数、lambda、闭包、递归
# ==========================================================

# ---- 基本定义 ----
函数 加(a, b) {
    返回 a + b
}
输出("加(3, 4) =", 加(3, 4))

# 单表达式写法（=> 后直接是返回值）
函数 平方(x) => x * x
输出("平方(9) =", 平方(9))

# ---- 默认参数与命名参数 ----
函数 建账号(名字, 年龄=18, 城市="北京") {
    返回 "${名字}（${年龄}岁，来自${城市}）"
}
输出(建账号("小明"))
输出(建账号("小红", 城市="上海"))
输出(建账号("小刚", 20, "广州"))

# ---- 可变参数 ----
函数 加总(*数字) {
    让 总 = 0
    遍历 n 于 数字 { 总 += n }
    返回 总
}
输出("加总(1,2,3,4,5) =", 加总(1, 2, 3, 4, 5))

# ---- Lambda 箭头函数 ----
让 翻倍 = x => x * 2
输出("翻倍(21) =", 翻倍(21))
输出("匿名函数直接调用：", ((a, b) => a * b)(6, 7))

# ---- 闭包：函数记住它被创建时的环境 ----
函数 造累加器(起点) {
    让 当前 = 起点
    返回 x => {
        当前 += x
        返回 当前
    }
}
让 累加 = 造累加器(100)
输出(累加(1), 累加(2), 累加(3))     # 101 103 106

# ---- 递归 ----
函数 斐波那契(n) {
    如果 n <= 1 { 返回 n }
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
}
写("斐波那契前 10 项：")
遍历 i 于 范围(10) { 写(斐波那契(i), " ") }
输出()

# 尾递归风格 + 中间变量，计算更快
函数 斐波那契快(n) {
    让 a = 0
    让 b = 1
    遍历 _ 于 范围(n) {
        让 t = a + b
        a = b
        b = t
    }
    返回 a
}
输出("斐波那契快(50) =", 斐波那契快(50))

# ---- 函数是一等公民：可以传进别的函数 ----
函数 应用两次(f, x) => f(f(x))
输出("应用两次(平方, 3) =", 应用两次(平方, 3))   # (3²)² = 81

# ---- 管道 |> ：把左边的值送给右边的函数 ----
让 结果 = 范围(1, 11) |> 过滤(x => x % 3 == 0) |> 映射(平方) |> 求和()
输出("1~10 中 3 的倍数平方和 =", 结果)   # 9+36+81 = 126
