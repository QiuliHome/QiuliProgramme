# 用例 01：运算符、优先级、类型转换

# 算术
断言(1 + 2 == 3)
断言(7 - 9 == -2)
断言(6 * 7 == 42)
断言(7 / 2 == 3.5)
断言(6 / 3 == 2)          # 能整除时结果为整数
断言(7 // 2 == 3)
断言(-7 // 2 == -4)
断言(7 % 3 == 1)
断言(2 ** 10 == 1024)
断言(2 ** 0.5 > 1.41 且 2 ** 0.5 < 1.42)

# 优先级：先乘除后加减，幂运算优先级最高
断言(1 + 2 * 3 == 7)
断言((1 + 2) * 3 == 9)
断言(2 ** 3 ** 2 == 512)  # 右结合

# 字符串拼接与重复
断言("你好" + "世界" == "你好世界")
断言("ab" * 3 == "ababab")
断言(3 * "ab" == "ababab")
断言("第" + 1 == "第1")

# 比较与逻辑
断言(1 < 2 且 2 <= 2 且 3 > 2 且 3 >= 3)
断言(1 == 1.0)
断言(1 != 2)
断言(真 且 非 假)
断言(假 或 真)
断言(非 空)

# 真假判定：只有 空 和 假 为假
断言(0 ? 真 : 假)
断言("" ? 真 : 假)
断言(空 ? 假 : 真)

# 类型转换
断言(整数("42") == 42)
断言(整数(3.9) == 3)
断言(浮点("3.5") == 3.5)
断言(字符串(123) == "123")
断言(布尔(1))
断言(类型(1) == "数字")
断言(类型("a") == "字符串")
断言(类型([]) == "列表")
断言(类型({}) == "字典")
断言(类型(空) == "空值")

# 数字字面量
断言(1_000 == 1000)
断言(0xFF == 255)
断言(0b101 == 5)
断言(0o17 == 15)
断言(1.5e3 == 1500)

输出("用例 01 全部通过 ✔")
