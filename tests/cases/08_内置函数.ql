# 用例 08：内置函数、类型方法、模块函数

# ---- 类型转换与查询 ----
断言(字符串(123) == "123")
断言(字符串(空) == "空")
断言(数字("3.5") == 3.5)
断言(数字("abc") == 空)
断言(整数(3.9) == 3)
断言(浮点("1.5") == 1.5)
断言(布尔(1) == 真)
断言(布尔(空) == 假)
断言(列表("ab") == ["a", "b"])
断言(长度([1, 2, 3]) == 3)
断言(长度("abcd") == 4)
断言(长度({"a": 1}) == 1)
断言(长度(1..5) == 5)
断言(类型(1.5) == "数字")
断言(是数字(1) 且 非 是数字("1"))
断言(是列表([]) 且 是字典({}) 且 是空(空))

# ---- 数学 ----
断言(绝对值(-3) == 3)
断言(平方根(9) == 3)
断言(幂(2, 8) == 256)
断言(四舍五入(3.14159, 2) == 3.14)
断言(上取整(3.1) == 4)
断言(下取整(3.9) == 3)
断言(最大(1, 5, 3) == 5)
断言(最小(1, 5, 3) == 1)
断言(最大([1, 5, 3]) == 5)
断言(求和([1, 2, 3]) == 6)

# ---- 序列 ----
断言(范围(3) == [0, 1, 2])
断言(范围(1, 4) == [1, 2, 3])
断言(范围(0, 10, 5) == [0, 5])
断言(枚举(["a"]) == [[0, "a"]])
断言(压缩([1], ["a"]) == [[1, "a"]])
断言(映射(x => x + 1, [1, 2]) == [2, 3])
断言(过滤(x => x > 1, [1, 2]) == [2])
断言(归约((a, b) => a + b, [1, 2, 3]) == 6)
断言(归约((a, b) => a + b, [1, 2, 3], 10) == 16)
断言(排序([3, 1, 2]) == [1, 2, 3])
断言(排序([3, 1, 2], x => -x) == [3, 2, 1])
断言(反转([1, 2]) == [2, 1])
断言(反转("ab") == "ba")
断言(去重([1, 1, 2]) == [1, 2])
断言(展平([1, [2, [3]]]) == [1, 2, 3])
断言(连接(["a", "b"], "-") == "a-b")
断言(分割("a,b", ",") == ["a", "b"])
断言(切片([1, 2, 3, 4], 1, 3) == [2, 3])
断言(包含([1, 2], 2))
断言(切片("abcd", 0, 2) == "ab")

# ---- 字符串 ----
断言(替换("aaa", "a", "b") == "bbb")
断言(去空白("  x  ") == "x")
断言(大写("ab") == "AB")
断言(小写("AB") == "ab")
断言(查找("abc", "b") == 1)
断言(计数("aaa", "a") == 3)
断言(字符码("A") == 65)
断言(码转字符(65) == "A")
断言(补零("7", 3) == "007")
断言(格式化("{} - {}", "a", 1) == "a - 1")
断言("abc".填充(5) == "abc  ")
断言("abc".居中(5) == " abc ")
断言("1,2".分割(",").长度 == 2)

# ---- 时间与随机 ----
让 现在时间 = 现在()
断言(类型(现在时间) == "字符串")
断言(现在时间.长度 == 19)
断言(时间戳() > 1600000000)
让 骰 = 随机整数(1, 6)
断言(骰 >= 1 且 骰 <= 6)
让 r0 = 随机()
断言(r0 >= 0 且 r0 < 1)

# ---- JSON ----
让 文本 = JSON生成({"a": 1, "b": [1, 2]})
让 还原 = JSON解析(文本)
断言(还原["a"] == 1)
断言(还原["b"] == [1, 2])

# ---- 其它 ----
断言(帮助().包含("输出"))
断言(帮助("输出").长度 > 5)
让 e = 错误("坏了", 类型="测试错误")
断言(e.消息 == "坏了")
断言(e.类型 == "测试错误")

导入 "终端" 作为 c
让 红字 = c.红("警告")
断言(红字.包含("警告"))
断言(红字.长度 > "警告".长度)      # 带有颜色转义序列

导入 "字符串" 作为 s
断言(s.格式化("{} {}", "a", "b") == "a b")
断言(s.重复("ab", 2) == "abab")

# ---- 管道 ----
让 管道结果 = [1, 2, 3, 4] |> 过滤(x => x % 2 == 0) |> 求和()
断言(管道结果 == 6)

输出("用例 08 全部通过 ✔")
