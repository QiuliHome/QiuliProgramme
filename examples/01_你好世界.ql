# ==========================================================
#  01 你好世界
#  运行：python qiuli.py examples/01_你好世界.ql
# ==========================================================

输出("你好，世界！")
输出("这是 Qiuli —— 一门后缀为 .ql 的中文脚本语言")

# 输出 可以一次打印多个值，用空格分隔
输出("1 + 1 =", 1 + 1)

# 写 打印但不换行，常和 输入 搭配
写("你叫什么名字？")
让 名字 = 输入()
输出("欢迎你，${名字}！")

# 字符串插值：在 "..." 里用 ${表达式}
让 年龄 = 18
输出("${名字} 明年 ${年龄 + 1} 岁")

# 注释有两种写法
# 双斜杠 // 在 Qiuli 里是整除运算符，单行注释请用井号
/* 块注释
   可以写多行 */
