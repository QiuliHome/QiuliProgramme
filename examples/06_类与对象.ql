# ==========================================================
#  06 类与对象：构造、继承、父、self、运算符重载
# ==========================================================

类 图形 {
    让 类别名 = "图形"

    构造(名字) {
        自身.名字 = 名字
    }

    描述() {
        返回 "这是一个${自身.类别名}：${自身.名字}"
    }

    面积() {
        返回 0
    }
}

类 矩形 继承 图形 {
    构造(宽, 高) {
        父.init("矩形")
        自身.类别名 = "矩形"
        自身.宽 = 宽
        自身.高 = 高
    }

    面积() {
        返回 自身.宽 * 自身.高
    }

    周长() {
        返回 2 * (自身.宽 + 自身.高)
    }

    # 运算符重载：让 矩形 + 矩形 有意义
    __加__(另一个) {
        返回 矩形(自身.宽 + 另一个.宽, 自身.高 + 另一个.高)
    }

    # 定义对象被转成字符串时的样子
    __字符串__() {
        返回 "矩形(${自身.宽}×${自身.高})"
    }
}

类 圆形 继承 图形 {
    构造(半径) {
        父.init("圆形")
        自身.类别名 = "圆形"
        自身.半径 = 半径
    }
    面积() {
        返回 3.14159 * 自身.半径 ** 2
    }
}

让 r = 矩形(3, 4)
输出(r.描述())
输出("面积：", r.面积(), " 周长：", r.周长())
输出("字符串化：", 字符串(r))

让 c = 圆形(2)
输出(c.描述(), " 面积：", c.面积())

# 运算符重载生效
让 r2 = r + 矩形(1, 1)
输出("矩形相加：", 字符串(r2))

# 多态：不同子类调用同名方法
让 图形们 = [r, c, 矩形(2, 2)]
遍历 g 于 图形们 {
    输出("  ", 字符串(g), "面积 =", g.面积())
}

# ---- 一个更实用的例子：栈 ----
类 栈 {
    构造() {
        自身.数据 = []
    }
    压入(x) {
        自身.数据.追加(x)
        返回 自身
    }
    弹出() {
        如果 自身.数据.长度 == 0 { 返回 空 }
        返回 自身.数据.弹出()
    }
    看看() {
        如果 自身.数据.长度 == 0 { 返回 空 }
        返回 自身.数据[-1]
    }
    大小() => 自身.数据.长度
    是否为空() => 自身.数据.长度 == 0
}

让 s = 栈()
s.压入("第一").压入("第二").压入("第三")
输出("栈顶：", s.看看(), " 大小：", s.大小())
输出("弹出：", s.弹出(), s.弹出(), s.弹出(), " 空了吗：", s.是否为空())

# ---- 银行账户：封装与校验 ----
类 账户 {
    构造(户主, 初始余额=0) {
        自身.户主 = 户主
        自身.余额 = 初始余额
        自身.流水 = []
    }
    存款(金额) {
        如果 金额 <= 0 { 抛出 错误("存款金额必须大于 0") }
        自身.余额 += 金额
        自身.流水.追加("存款 +${金额}")
        返回 自身.余额
    }
    取款(金额) {
        如果 金额 > 自身.余额 { 抛出 错误("余额不足") }
        自身.余额 -= 金额
        自身.流水.追加("取款 -${金额}")
        返回 自身.余额
    }
    对账单() {
        输出("— ${自身.户主} 的账户 —")
        遍历 记录 于 自身.流水 { 输出("  ", 记录) }
        输出("  当前余额：${自身.余额}")
    }
}

让 我的账户 = 账户("小明", 100)
尝试 {
    我的账户.存款(50)
    我的账户.取款(30)
    我的账户.取款(500)
} 捕获 e {
    输出("出错了：", e.消息)
}
我的账户.对账单()
