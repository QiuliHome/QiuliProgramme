# ==========================================================
#  08 模块与文件：内置模块、.ql 文件模块、读写文件、JSON
# ==========================================================

# ---- 内置模块 ----
导入 "数学" 作为 m
输出("π =", m.圆周率)
输出("√2 =", m.平方根(2))
输出("2^10 =", m.幂(2, 10))
输出("sin(π/2) =", m.正弦(m.圆周率 / 2))
输出("10 是质数吗：", m.是质数(10), " 17 是质数吗：", m.是质数(17))

导入 "时间" 作为 t
输出("现在：", t.现在())
输出("今天是今年第", t.格式化(t.时间戳(), "%j"), "天")

从 "随机" 导入 整数, 选择
输出("掷骰子：", 整数(1, 6))
输出("抽签：", 选择(["一等奖", "二等奖", "谢谢参与"]))

# ---- 导入自己写的 .ql 文件 ----
导入 "数据结构" 作为 ds
让 队列 = ds.建队列()
队列.入队("任务1").入队("任务2")
输出("出队：", 队列.出队(), " 剩余：", 队列.大小())

# ---- 文件读写 ----
常量 临时文件 = "_08_临时.txt"
写文件(临时文件, "第一行\n第二行\n第三行")
输出("文件内容：")
输出(读文件(临时文件))
输出("按行读：", 读文件(临时文件).分割("\n"))
追加文件(临时文件, "\n第四行")
输出("追加后行数：", 读文件(临时文件).分割("\n").长度)
输出("文件存在吗：", 文件存在(临时文件))

# ---- JSON ----
让 数据 = {
    "姓名": "小明",
    "年龄": 18,
    "爱好": ["编程", "篮球"],
    "在校": 真
}
让 文本 = JSON生成(数据)
输出("JSON：")
输出(文本)
让 还原 = JSON解析(文本)
输出("还原后的姓名：", 还原["姓名"], " 爱好：", 还原["爱好"])

# ---- 综合小练习：把成绩单存成 JSON 再读回来 ----
让 成绩单 = [
    {"姓名": "小明", "分数": 88},
    {"姓名": "小红", "分数": 95},
    {"姓名": "小刚", "分数": 72}
]
写文件("_08_成绩.json", JSON生成(成绩单))
让 读回 = JSON解析(读文件("_08_成绩.json"))
让 平均 = 求和(映射(x => x["分数"], 读回)) / 读回.长度
输出("平均分：", 平均)
输出("最高分：", 最大(映射(x => x["分数"], 读回)))

# 清理临时文件（顺便演示 文件 模块的删除）
导入 "文件" 作为 fs
遍历 要删的 于 [临时文件, "_08_成绩.json"] {
    如果 fs.存在(要删的) {
        尝试 { fs.删除(要删的) } 捕获 e { 输出("删除失败：", e.消息) }
    }
}
输出("临时文件已清理")
