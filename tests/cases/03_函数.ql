# 用例 03：函数、参数、闭包、递归、管道

# 基本调用与返回值
函数 加(a, b) { 返回 a + b }
断言(加(1, 2) == 3)

函数 无返回() { 让 x = 1 }
断言(无返回() == 空)

# 单表达式函数
函数 平方(x) => x * x
断言(平方(6) == 36)

# 默认参数
函数 问候(谁="朋友", 后缀="！") => "你好${谁}${后缀}"
断言(问候() == "你好朋友！")
断言(问候("小明") == "你好小明！")
断言(问候("小红", "～") == "你好小红～")

# 命名参数
函数 建点(x=0, y=0) => [x, y]
断言(建点(y=5) == [0, 5])
断言(建点(x=3, y=4) == [3, 4])

# 可变参数
函数 加总(*数字) {
    让 s = 0
    遍历 n 于 数字 { s += n }
    返回 s
}
断言(加总() == 0)
断言(加总(1, 2, 3) == 6)

# lambda
让 翻倍 = x => x * 2
断言(翻倍(4) == 8)
断言(((a, b) => a + b)(1, 2) == 3)

# 闭包：内部状态被记住
函数 造计数器() {
    让 n = 0
    返回 () => { n += 1  返回 n }
}
让 c1 = 造计数器()
让 c2 = 造计数器()
断言(c1() == 1)
断言(c1() == 2)
断言(c2() == 1)        # 两个计数器互不影响

# 递归
函数 阶乘(n) => n <= 1 ? 1 : n * 阶乘(n - 1)
断言(阶乘(5) == 120)

函数 斐波那契(n) {
    如果 n <= 1 { 返回 n }
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
}
断言(斐波那契(10) == 55)

# 函数作为值与高阶函数
函数 应用(f, x) => f(x)
断言(应用(平方, 5) == 25)

# 管道：左边作为最后一个实参
让 结果 = 范围(1, 6) |> 过滤(x => x % 2 == 1) |> 映射(平方) |> 求和()
断言(结果 == 35)        # 1 + 9 + 25

# 作用域：内层能读外层，外层读不到内层
让 外面 = 10
函数 读外面() => 外面 + 1
断言(读外面() == 11)

# 块级作用域
让 可见 = 空
如果 真 {
    让 里面 = 1
    可见 = 里面
}
断言(可见 == 1)

输出("用例 03 全部通过 ✔")
