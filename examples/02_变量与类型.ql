# ==========================================================
#  02 变量与类型
# ==========================================================

# 让 声明变量（可修改），常量 声明不可修改的绑定
让 计数 = 10
常量 圆周率 = 3.14159
计数 = 计数 + 1
输出("计数 =", 计数, " 圆周率 =", 圆周率)

# 基本类型：数字、字符串、布尔、空
让 整数值 = 42
让 小数值 = 3.14
让 文本 = "Qiuli"
让 是否 = 真
让 什么都没有 = 空

输出(类型(整数值), 类型(小数值), 类型(文本), 类型(是否), 类型(什么都没有))

# 数字字面量支持下划线分隔与进制
让 大数 = 1_000_000
让 十六 = 0xFF        # 255
让 二 = 0b1010        # 10
让 八 = 0o17          # 15
让 科学 = 1.5e3       # 1500
输出(大数, 十六, 二, 八, 科学)

# 运算
输出("7 / 2 =", 7 / 2)      # 3.5
输出("7 // 2 =", 7 // 2)    # 3（整除）
输出("7 % 2 =", 7 % 2)      # 1
输出("2 ** 10 =", 2 ** 10)  # 1024

# 复合赋值
让 x = 5
x += 3
x *= 2
x -= 1
输出("x =", x)   # ((5+3)*2)-1 = 15

# 类型转换
输出(字符串(123) + "456")     # "123456"
输出(整数("42") + 1)          # 43
输出(浮点("3.5") * 2)         # 7.0
输出(布尔(0), 布尔(""), 布尔(空), 布尔(假))
# 注意：Qiuli 中只有 空 与 假 为假，0 和 "" 都是真

# 真假判断
如果 0 {
    输出("0 在 Qiuli 里是真值")
}
如果 空 { 输出("不会执行") } 否则 { 输出("空 是假值") }
