# 用例 07：内置模块、.ql 文件模块、导入语法

# ---- 内置模块 ----
导入 "数学" 作为 m
断言(m.平方根(16) == 4)
断言(m.绝对值(-5) == 5)
断言(m.上取整(3.2) == 4)
断言(m.下取整(3.8) == 3)
断言(m.四舍五入(3.14159, 2) == 3.14)
断言(m.最大公约数(12, 18) == 6)
断言(m.是质数(17))
断言(非 m.是质数(18))
断言(m.斐波那契(10) == 55)
断言(m.圆周率 > 3.14 且 m.圆周率 < 3.15)

导入 "时间" 作为 t
断言(t.现在().长度 == 19)
断言(t.今天().长度 == 10)
断言(t.年() > 2020)
断言(t.时() >= 0 且 t.时() <= 23)

导入 "随机" 作为 r
让 骰子 = r.整数(1, 6)
断言(骰子 >= 1 且 骰子 <= 6)
断言(r.选择(["a"]) == "a")
让 待打乱 = [1, 2, 3, 4, 5]
r.打乱(待打乱)
断言(待打乱.长度 == 5)
断言(排序(待打乱) == [1, 2, 3, 4, 5])

导入 "JSON" 作为 j
让 原文 = j.生成({"a": 1, "b": [1, 2]})
让 还原 = j.解析(原文)
断言(还原["a"] == 1)
断言(还原["b"] == [1, 2])

导入 "字符串" 作为 s
断言(s.格式化("{} - {}", "a", "b") == "a - b")
断言(s.补零("7", 3) == "007")

导入 "文件" 作为 f
常量 临时 = "_07_测试文件.txt"
f.写(临时, "hello")
断言(f.存在(临时))
断言(f.读(临时) == "hello")
断言(f.读行(临时) == ["hello"])
尝试 { f.删除(临时) } 捕获 e { }   # 删除失败（如权限限制）不影响测试

# ---- 从模块里只导入需要的名字 ----
从 "数学" 导入 平方根, 圆周率
断言(平方根(9) == 3)
断言(圆周率 > 3)

# ---- 自己写的 .ql 模块 ----
导入 "数据结构" 作为 ds

让 栈 = ds.建栈()
栈.压入(1).压入(2)
断言(栈.栈顶() == 2)
断言(栈.弹出() == 2)
断言(栈.大小() == 1)

让 队列 = ds.建队列()
队列.入队("a").入队("b")
断言(队列.出队() == "a")
断言(队列.大小() == 1)

让 链表 = ds.建链表()
链表.尾部追加(1).尾部追加(2).头部追加(0)
断言(链表.转列表() == [0, 1, 2])
断言(链表.包含(2))
断言(链表.删除(1))
断言(链表.转列表() == [0, 2])

让 树 = ds.建二叉搜索树()
遍历 v 于 [5, 3, 8, 1, 4] { 树.插入(v) }
断言(树.中序遍历() == [1, 3, 4, 5, 8])
断言(树.包含(4))
断言(非 树.包含(99))

让 堆 = ds.建优先队列()
遍历 v 于 [3, 1, 2] { 堆.放入(v) }
断言(堆.取出() == 1)
断言(堆.取出() == 2)
断言(堆.取出() == 3)
断言(堆.取出() == 空)

输出("用例 07 全部通过 ✔")
