# ==========================================================
#  12 小游戏：井字棋（人机对战）
#  棋盘位置编号：
#       1 │ 2 │ 3
#      ───┼───┼───
#       4 │ 5 │ 6
#      ───┼───┼───
#       7 │ 8 │ 9
# ==========================================================

让 棋盘 = [" ", " ", " ", " ", " ", " ", " ", " ", " "]
常量 玩家 = "✗"
常量 电脑 = "○"

常量 获胜线 = [
    [0, 1, 2], [3, 4, 5], [6, 7, 8],     # 横
    [0, 3, 6], [1, 4, 7], [2, 5, 8],     # 竖
    [0, 4, 8], [2, 4, 6]                 # 斜
]

函数 显示棋盘() {
    输出("")
    遍历 i 于 范围(3) {
        让 行 = 范围(i * 3, i * 3 + 3)
        让 文本 = ""
        遍历 j 于 行 {
            让 格 = 棋盘[j]
            文本 += (格 == " " ? 字符串(j + 1) : 格)
            如果 j != 行[2] { 文本 += " │ " }
        }
        输出("   " + 文本)
        如果 i < 2 { 输出("  ───┼───┼───") }
    }
    输出("")
}

函数 赢家() {
    遍历 线 于 获胜线 {
        让 a = 棋盘[线[0]]
        如果 a != " " 且 a == 棋盘[线[1]] 且 a == 棋盘[线[2]] {
            返回 a
        }
    }
    返回 空
}

函数 空位() {
    让 结果 = []
    让 i = 0
    遍历 格 于 棋盘 {
        如果 格 == " " { 结果.追加(i) }
        i += 1
    }
    返回 结果
}

# 电脑的策略：能赢就赢，该堵就堵，否则挑好位置
函数 电脑选位() {
    让 可选 = 空位()
    如果 可选.长度 == 0 { 返回 空 }

    遍历 棋子 于 [电脑, 玩家] {
        遍历 位 于 可选 {
            棋盘[位] = 棋子
            让 赢了 = 赢家() != 空
            棋盘[位] = " "
            如果 赢了 { 返回 位 }
        }
    }
    如果 棋盘[4] == " " { 返回 4 }
    遍历 位 于 [0, 2, 6, 8] {
        如果 棋盘[位] == " " { 返回 位 }
    }
    返回 可选[0]
}

# 返回 假 表示玩家想退出（或直接遇到了输入结束）
函数 玩家回合() {
    当 真 {
        写("请落子（1-9，输入 0 退出）：")
        让 原始 = 输入()
        如果 原始 == 空 { 返回 假 }
        让 输入值 = 数字(原始)
        如果 输入值 == 0 { 返回 假 }
        如果 输入值 == 空 或 整数(输入值) < 1 或 整数(输入值) > 9 {
            输出("  请输入 1 到 9 之间的数字")
            继续
        }
        让 位置 = 整数(输入值) - 1
        如果 棋盘[位置] != " " {
            输出("  那个位置已经有棋子了")
            继续
        }
        棋盘[位置] = 玩家
        返回 真
    }
}

输出("═══════════════════════════")
输出("   井字棋：你（✗） vs 电脑（○）")
输出("═══════════════════════════")
显示棋盘()

让 回合 = 0
当 回合 < 9 {
    让 继续玩 = 玩家回合()
    如果 非 继续玩 { 输出("（游戏结束）")  中断 }
    回合 += 1
    如果 赢家() == 玩家 {
        显示棋盘()
        输出("🎊 你赢了！")
        中断
    }
    如果 空位().长度 == 0 { 中断 }

    让 电脑位 = 电脑选位()
    棋盘[电脑位] = 电脑
    回合 += 1
    输出("电脑下在 ${电脑位 + 1} 号位")

    如果 赢家() == 电脑 {
        显示棋盘()
        输出("🤖 电脑赢了，再来一局？")
        中断
    }
}

如果 赢家() == 空 {
    显示棋盘()
    输出("🤝 平局")
}
