# 用例 04：列表、字典、字符串、切片

# ---- 列表 ----
让 a = [1, 2, 3]
断言(a.长度 == 3)
断言(a[0] == 1)
断言(a[-1] == 3)
a.追加(4)
断言(a == [1, 2, 3, 4])
断言(a.弹出() == 4)
断言(a == [1, 2, 3])
断言(a[0:2] == [1, 2])
断言(a[1:] == [2, 3])
断言(a[:2] == [1, 2])
断言(a.包含(1))
断言(排序([3, 1, 2]) == [1, 2, 3])
断言(反转([1, 2, 3]) == [3, 2, 1])
断言([1, 2] + [3] == [1, 2, 3])
断言(去重([1, 1, 2]) == [1, 2])
断言(展平([1, [2, [3]]]) == [1, 2, 3])
断言(长度(范围(5)) == 5)
断言(范围(1, 4) == [1, 2, 3])

# 元素是引用：函数内修改会影响外面
函数 改列表(x) { x[0] = 99 }
让 b = [1]
改列表(b)
断言(b[0] == 99)

# 高阶函数
断言(映射(x => x * 2, [1, 2]) == [2, 4])
断言(过滤(x => x > 1, [1, 2, 3]) == [2, 3])
断言(归约((x, y) => x + y, [1, 2, 3], 0) == 6)
断言(求和([1, 2, 3]) == 6)
断言(最大([1, 5, 3]) == 5)
断言(最小([1, 5, 3]) == 1)
断言(枚举(["a", "b"]) == [[0, "a"], [1, "b"]])

# ---- 字典 ----
让 d = {"a": 1, "b": 2}
断言(d["a"] == 1)
d["c"] = 3
断言(d.长度 == 3)
断言(d.包含("c"))
断言(d.取("不存在", 0) == 0)
断言(d.键.长度 == 3)
让 d2 = {"x": 1}
d2["y"] = 2
断言(d2.值.长度 == 2)

# ---- 字符串 ----
让 s = "Qiuli 秋黎"
断言(s.长度 == 8)
断言(s[0] == "Q")
断言(s[0:5] == "Qiuli")
断言(s.大写().小写() == "qiuli 秋黎")
断言("  x  ".去空白() == "x")
断言("a-b-c".分割("-") == ["a", "b", "c"])
断言("aaa".替换("a", "b") == "bbb")
断言("abc".包含("b"))
断言("abc".反转() == "cba")
断言(["a", "b"].连接("-") == "a-b")
断言("a" * 3 == "aaa")

# 字符串插值
让 名字 = "小明"
让 年龄 = 18
断言("${名字}今年${年龄}岁" == "小明今年18岁")
断言("1+1=${1+1}" == "1+1=2")
断言("${[1,2].长度}个" == "2个")
断言("${名字[0]}同学" == "小同学")

# 转义字符
断言("a\nb".长度 == 3)
断言("a\tb" == "a\tb")

输出("用例 04 全部通过 ✔")
