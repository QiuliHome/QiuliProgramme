# ==========================================================
#  05 列表与字典
# ==========================================================

# ---- 列表 ----
让 数字 = [3, 1, 4, 1, 5, 9, 2, 6]
输出("列表：", 数字, " 长度：", 数字.长度)

数字.追加(5)
输出("追加后：", 数字)
输出("弹出最后一个：", 数字.弹出())
输出("下标 0：", 数字[0], "  倒数第一个：", 数字[-1])
输出("切片 [2:5]：", 数字[2:5])
输出("包含 9 吗：", 数字.包含(9))
输出("5 出现的次数：", 数字.计数(5))

# 排序 / 反转（原地）与 排序()（返回新列表）
让 副本 = 排序(数字)
输出("升序：", 副本)
输出("降序：", 排序(数字, x => -x))
输出("反转：", 反转(数字))

# ---- 高阶函数 ----
让 偶数 = 过滤(x => x % 2 == 0, 数字)
让 翻倍 = 映射(x => x * 2, 数字)
让 总和 = 归约((a, b) => a + b, 数字, 0)
输出("偶数：", 偶数)
输出("翻倍：", 翻倍)
输出("总和：", 总和)
输出("最大值：", 最大(数字), " 最小值：", 最小(数字))

# 每个：只遍历做事，不返回结果
写("逐个打印：")
数字.每个(x => 写(x, " "))
输出()

# ---- 字符串也支持下标与切片 ----
让 文本 = "Qiuli 秋黎"
输出(文本[0], 文本[-1], 文本[0:5])
输出(文本.大写(), "|", 文本.小写())
输出("Qiuli".替换("Q", "q"))
输出("  两边有空格  ".去空白())
输出("a,b,c".分割(","))

# ---- 字典 ----
让 成绩 = {"语文": 88, "数学": 95, "英语": 91}
输出("语文：", 成绩["语文"])
成绩["物理"] = 89
输出("全部科目：", 成绩.键)
输出("全部分数：", 成绩.值)
输出("有几科：", 成绩.长度)
输出("有化学吗：", 成绩.包含("化学"))
输出("安全地取：", 成绩.取("化学", 0))

遍历 科目, 分数 于 成绩 {
    输出("  ${科目}：${分数}")
}

# ---- 嵌套结构 ----
让 班级 = [
    {"姓名": "小明", "成绩": 88},
    {"姓名": "小红", "成绩": 95},
    {"姓名": "小刚", "成绩": 72}
]
# 插值里如果要写下标，用单引号避免和外层的双引号打架
遍历 学生 于 班级 {
    输出("${学生['姓名']} 考了 ${学生['成绩']} 分")
}
让 平均分 = 求和(映射(s => s["成绩"], 班级)) / 班级.长度
输出("班级平均分：", 平均分)

# 按成绩排序
让 排名 = 排序(班级, s => -s["成绩"])
输出("第一名是：", 排名[0]["姓名"])

# ---- 去重、展平、压缩 ----
输出("去重：", 去重([1, 2, 2, 3, 3, 3]))
输出("展平：", 展平([1, [2, 3], [4, [5]]]))
输出("压缩：", 压缩([1, 2, 3], ["a", "b", "c"]))
