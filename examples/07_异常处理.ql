# ==========================================================
#  07 异常处理：尝试 / 捕获 / 最终 / 抛出
# ==========================================================

# ---- 基本用法 ----
函数 除(a, b) {
    如果 b == 0 {
        抛出 错误("除数不能为 0", 类型="参数错误")
    }
    返回 a / b
}

尝试 {
    输出("10 / 2 =", 除(10, 2))
    输出("10 / 0 =", 除(10, 0))    # 这里会抛出
    输出("这行不会执行")
} 捕获 e {
    输出("捕获到异常：${e.消息}（类型：${e.类型}）")
} 最终 {
    输出("—— 最终 块总会执行，适合做清理工作")
}

# ---- 捕获指定类型的异常 ----
函数 取下标(列表, 下标) {
    如果 下标 >= 列表.长度 {
        抛出 错误("下标越界：${下标}", 类型="越界错误")
    }
    返回 列表[下标]
}

尝试 {
    取下标([1, 2, 3], 99)
} 捕获 越界错误 as e {
    输出("专门捕获越界错误：", e.消息)
} 捕获 e {
    输出("其它错误：", e.消息)
}

# ---- 内置错误也会被捕获 ----
尝试 {
    让 x = "文本" - 1      # 字符串不能做减法
    输出(x)
} 捕获 e {
    输出("内置错误也能捕获：", e.消息)
}

# ---- 抛出任意值 ----
尝试 {
    抛出 "我是一个字符串异常"
} 捕获 e {
    输出("捕获到：", e)
}

# ---- 用异常做输入校验 ----
函数 注册用户(名字, 年龄) {
    如果 名字.去空白() == "" { 抛出 错误("名字不能为空") }
    如果 年龄 < 0 或 年龄 > 150 { 抛出 错误("年龄不合法：${年龄}") }
    返回 {"名字": 名字, "年龄": 年龄}
}

遍历 候选人 于 [["小明", 18], ["", 20], ["小红", 200]] {
    尝试 {
        让 用户 = 注册用户(候选人[0], 候选人[1])
        输出("注册成功：", 用户)
    } 捕获 e {
        输出("注册失败：", e.消息)
    }
}

# ---- 断言：调试利器 ----
让 总数 = 100
断言(总数 > 0, "总数应该大于 0")
输出("断言通过，程序继续")
