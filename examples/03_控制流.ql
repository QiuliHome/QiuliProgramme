# ==========================================================
#  03 控制流：判断、循环、匹配
# ==========================================================

# ---- 如果 / 又如果 / 否则 ----
函数 评级(分数) {
    如果 分数 >= 90 { 返回 "优" }
    又如果 分数 >= 80 { 返回 "良" }
    又如果 分数 >= 60 { 返回 "及格" }
    否则 { 返回 "待努力" }
}
输出("95 →", 评级(95), "  73 →", 评级(73))

# 三元表达式：条件 ? 真值 : 假值
让 n = 7
输出(n, "是", n % 2 == 0 ? "偶数" : "奇数")

# ---- 当（while）循环 ----
让 i = 0
让 累加 = 0
当 i < 5 {
    累加 += i
    i += 1
}
输出("0+1+2+3+4 =", 累加)

# ---- 遍历（for）循环 ----
遍历 x 于 ["苹果", "香蕉", "橙子"] {
    输出("水果：", x)
}

遍历 下标, 值 于 ["甲", "乙", "丙"] {
    输出("第 ${下标} 个：${值}")
}

遍历 键, 值 于 {"语文": 88, "数学": 95} {
    输出("${键}：${值}")
}

# ---- 区间 ----
遍历 k 于 1..5 { 写(k, " ") }
输出("← 1..5 是闭区间")
遍历 k 于 范围(3) { 写(k, " ") }
输出("← 范围(3) 生成 [0,1,2]")

# ---- 中断 / 继续 ----
遍历 k 于 范围(10) {
    如果 k % 2 == 0 { 继续 }
    如果 k > 6 { 中断 }
    写(k, " ")
}
输出("← 只打印了奇数且不超 6")

# ---- 匹配 ----
函数 中文数字(x) {
    匹配 x {
        情形 0 { 返回 "零" }
        情形 1 { 返回 "一" }
        情形 2 { 返回 "二" }
        情形 3 { 返回 "三" }
        默认 { 返回 "很多" }
    }
}
输出(中文数字(2), 中文数字(9))

# 匹配还能直接绑定变量
匹配 "你好" {
    情形 文本 { 输出("匹配到任意文本：", 文本) }
}
