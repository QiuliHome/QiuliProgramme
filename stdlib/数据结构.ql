# ==========================================================
#  stdlib / 数据结构.ql
#  用 Qiuli 自己实现的常用数据结构
#  用法：导入 "数据结构" 作为 ds
# ==========================================================

# --------------------------------------------------------- 栈（后进先出）
类 栈 {
    构造() {
        自身.数据 = []
    }
    压入(x) {
        自身.数据.追加(x)
        返回 自身
    }
    弹出() {
        如果 自身.为空() { 返回 空 }
        返回 自身.数据.弹出()
    }
    栈顶() {
        如果 自身.为空() { 返回 空 }
        返回 自身.数据[-1]
    }
    大小() => 自身.数据.长度
    为空() => 自身.数据.长度 == 0
    清空() {
        自身.数据 = []
        返回 自身
    }
    转列表() => 自身.数据
}

函数 建栈() => 栈()

# --------------------------------------------------------- 队列（先进先出）
类 队列 {
    构造() {
        自身.数据 = []
    }
    入队(x) {
        自身.数据.追加(x)
        返回 自身
    }
    出队() {
        如果 自身.为空() { 返回 空 }
        返回 自身.数据.弹出(0)
    }
    队首() {
        如果 自身.为空() { 返回 空 }
        返回 自身.数据[0]
    }
    大小() => 自身.数据.长度
    为空() => 自身.数据.长度 == 0
    转列表() => 自身.数据
}

函数 建队列() => 队列()

# --------------------------------------------------------- 优先队列（二叉堆）
类 优先队列 {
    构造(比较函数=空) {
        自身.堆 = []
        # 比较函数返回 真 表示 a 的优先级更高（默认小顶堆）
        自身.比较 = 比较函数 或 (a, b) => a < b
    }
    大小() => 自身.堆.长度
    为空() => 自身.堆.长度 == 0

    _上浮(下标) {
        当 下标 > 0 {
            让 父位 = (下标 - 1) // 2
            如果 自身.比较(自身.堆[父位], 自身.堆[下标]) { 中断 }
            让 临时 = 自身.堆[父位]
            自身.堆[父位] = 自身.堆[下标]
            自身.堆[下标] = 临时
            下标 = 父位
        }
    }
    _下沉(下标) {
        让 n = 自身.堆.长度
        当 真 {
            让 左 = 2 * 下标 + 1
            让 右 = 左 + 1
            让 最小 = 下标
            如果 左 < n 且 自身.比较(自身.堆[左], 自身.堆[最小]) { 最小 = 左 }
            如果 右 < n 且 自身.比较(自身.堆[右], 自身.堆[最小]) { 最小 = 右 }
            如果 最小 == 下标 { 中断 }
            让 临时 = 自身.堆[最小]
            自身.堆[最小] = 自身.堆[下标]
            自身.堆[下标] = 临时
            下标 = 最小
        }
    }
    放入(x) {
        自身.堆.追加(x)
        自身._上浮(自身.堆.长度 - 1)
        返回 自身
    }
    取出() {
        如果 自身.为空() { 返回 空 }
        让 顶 = 自身.堆[0]
        让 末 = 自身.堆.弹出()
        如果 自身.堆.长度 > 0 {
            自身.堆[0] = 末
            自身._下沉(0)
        }
        返回 顶
    }
    查看() {
        如果 自身.为空() { 返回 空 }
        返回 自身.堆[0]
    }
}

函数 建优先队列(比较函数=空) => 优先队列(比较函数)

# --------------------------------------------------------- 单向链表
类 链表节点 {
    构造(值) {
        自身.值 = 值
        自身.下一个 = 空
    }
}

类 链表 {
    构造() {
        自身.头 = 空
        自身.长度 = 0
    }
    头部追加(值) {
        让 n = 链表节点(值)
        n.下一个 = 自身.头
        自身.头 = n
        自身.长度 += 1
        返回 自身
    }
    尾部追加(值) {
        让 n = 链表节点(值)
        如果 自身.头 == 空 {
            自身.头 = n
        } 否则 {
            让 p = 自身.头
            当 p.下一个 != 空 { p = p.下一个 }
            p.下一个 = n
        }
        自身.长度 += 1
        返回 自身
    }
    包含(值) {
        让 p = 自身.头
        当 p != 空 {
            如果 p.值 == 值 { 返回 真 }
            p = p.下一个
        }
        返回 假
    }
    删除(值) {
        如果 自身.头 == 空 { 返回 假 }
        如果 自身.头.值 == 值 {
            自身.头 = 自身.头.下一个
            自身.长度 -= 1
            返回 真
        }
        让 p = 自身.头
        当 p.下一个 != 空 {
            如果 p.下一个.值 == 值 {
                p.下一个 = p.下一个.下一个
                自身.长度 -= 1
                返回 真
            }
            p = p.下一个
        }
        返回 假
    }
    转列表() {
        让 结果 = []
        让 p = 自身.头
        当 p != 空 {
            结果.追加(p.值)
            p = p.下一个
        }
        返回 结果
    }
    __字符串__() {
        返回 字符串(自身.转列表())
    }
}

函数 建链表() => 链表()

# --------------------------------------------------------- 二叉搜索树
类 树节点 {
    构造(值) {
        自身.值 = 值
        自身.左 = 空
        自身.右 = 空
    }
    插入(值) {
        如果 值 < 自身.值 {
            如果 自身.左 == 空 { 自身.左 = 树节点(值) } 否则 { 自身.左.插入(值) }
        } 又如果 值 > 自身.值 {
            如果 自身.右 == 空 { 自身.右 = 树节点(值) } 否则 { 自身.右.插入(值) }
        }
        返回 自身
    }
    包含(值) {
        如果 值 == 自身.值 { 返回 真 }
        如果 值 < 自身.值 { 返回 自身.左 == 空 ? 假 : 自身.左.包含(值) }
        返回 自身.右 == 空 ? 假 : 自身.右.包含(值)
    }
}

类 二叉搜索树 {
    构造() {
        自身.根 = 空
        自身.个数 = 0
    }
    插入(值) {
        如果 自身.根 == 空 {
            自身.根 = 树节点(值)
        } 否则 {
            自身.根.插入(值)
        }
        自身.个数 += 1
        返回 自身
    }
    包含(值) {
        如果 自身.根 == 空 { 返回 假 }
        返回 自身.根.包含(值)
    }
    # 递归辅助方法：只对真正的节点递归（不能用默认参数 空，
    # 因为「没传参」和「传了空节点」无法区分）
    _中序(节点) {
        如果 节点 == 空 { 返回 [] }
        返回 自身._中序(节点.左) + [节点.值] + 自身._中序(节点.右)
    }
    中序遍历() {
        返回 自身._中序(自身.根)
    }
    大小() => 自身.个数
}

函数 建二叉搜索树() => 二叉搜索树()

# --------------------------------------------------------- 导出
导出 栈, 队列, 优先队列, 链表, 链表节点, 二叉搜索树, 树节点,
     建栈, 建队列, 建优先队列, 建链表, 建二叉搜索树
