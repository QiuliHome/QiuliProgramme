{
  "函数": {
    "prefix": ["fn", "函数"],
    "body": ["函数 ${1:名字}(${2:参数}) {", "\t$0", "}"],
    "description": "定义一个函数"
  },
  "类": {
    "prefix": ["class", "类"],
    "body": [
      "类 ${1:类名} {",
      "\t构造(${2:参数}) {",
      "\t\t自身.$3 = $3",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "定义一个类"
  },
  "如果": {
    "prefix": ["if", "如果"],
    "body": ["如果 ${1:条件} {", "\t$0", "}"],
    "description": "条件判断"
  },
  "如果否则": {
    "prefix": ["ifelse", "如果否则"],
    "body": ["如果 ${1:条件} {", "\t$2", "} 否则 {", "\t$0", "}"],
    "description": "条件判断 + 否则"
  },
  "遍历": {
    "prefix": ["for", "遍历"],
    "body": ["遍历 ${1:元素} 于 ${2:列表} {", "\t$0", "}"],
    "description": "遍历循环"
  },
  "遍历键值": {
    "prefix": ["forkv"],
    "body": ["遍历 ${1:键}, ${2:值} 于 ${3:字典} {", "\t$0", "}"],
    "description": "遍历字典的键与值"
  },
  "当": {
    "prefix": ["while", "当"],
    "body": ["当 ${1:条件} {", "\t$0", "}"],
    "description": "循环"
  },
  "尝试": {
    "prefix": ["try", "尝试"],
    "body": ["尝试 {", "\t$1", "} 捕获 ${2:e} {", "\t$0", "}"],
    "description": "异常捕获"
  },
  "匹配": {
    "prefix": ["match", "匹配"],
    "body": ["匹配 ${1:值} {", "\t情形 ${2:模式} {", "\t\t$3", "\t}", "\t默认 {", "\t\t$0", "\t}", "}"],
    "description": "模式匹配"
  },
  "箭头函数": {
    "prefix": ["lambda", "箭头"],
    "body": ["(${1:x}) => ${0:x}"],
    "description": "匿名函数"
  },
  "导入模块": {
    "prefix": ["import", "导入"],
    "body": ["导入 \"${1:数学}\" 作为 ${2:m}"],
    "description": "导入模块"
  },
  "输出": {
    "prefix": ["print", "输出"],
    "body": ["输出($0)"],
    "description": "打印一行"
  },
  "插值": {
    "prefix": ["i18n", "插值"],
    "body": ["\"${${1:表达式}}\""],
    "description": "字符串插值"
  },
  "文件头": {
    "prefix": ["header", "文件头"],
    "body": [
      "# ==========================================================",
      "#  ${1:标题}",
      "#  运行：python qiuli.py ${TM_FILENAME}",
      "# ==========================================================",
      "",
      "$0"
    ],
    "description": "脚本文件头注释"
  }
}
