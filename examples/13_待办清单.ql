# ==========================================================
#  13 小应用：待办清单（数据存到本地 JSON 文件）
#  这是一个「真的能用」的小程序：添加 / 完成 / 删除 / 保存
# ==========================================================

常量 文件路径 = "_13_待办.json"

让 任务表 = []

函数 载入() {
    如果 文件存在(文件路径) {
        让 文本 = 读文件(文件路径)
        如果 文本.去空白() != "" {
            任务表 = JSON解析(文本)
            输出("已从文件载入 ${任务表.长度} 条任务")
        }
    } 否则 {
        输出("没有找到存档，从空清单开始")
    }
}

函数 保存() {
    写文件(文件路径, JSON生成(任务表))
}

函数 显示() {
    输出("")
    如果 任务表.长度 == 0 {
        输出("（清单是空的）")
        返回
    }
    遍历 下标, 任务 于 任务表 {
        让 标记 = 任务["完成"] ? "✔" : "□"
        输出("  ${下标 + 1}. [${标记}] ${任务["内容"]}    （${任务["创建于"]}）")
    }
    让 未完成 = 过滤(t => 非 t["完成"], 任务表).长度
    输出("  共 ${任务表.长度} 条，未完成 ${未完成} 条")
}

函数 添加(内容) {
    任务表.追加({
        "内容": 内容,
        "完成": 假,
        "创建于": 现在()
    })
    输出("  已添加：${内容}")
}

函数 完成(序号) {
    如果 序号 < 1 或 序号 > 任务表.长度 {
        输出("  没有这个编号")
        返回
    }
    任务表[序号 - 1]["完成"] = 真
    输出("  已完成：${任务表[序号 - 1]["内容"]}")
}

函数 删除(序号) {
    如果 序号 < 1 或 序号 > 任务表.长度 {
        输出("  没有这个编号")
        返回
    }
    让 删掉的 = 任务表.弹出(序号 - 1)
    输出("  已删除：${删掉的["内容"]}")
}

函数 帮助() {
    输出("""
可用命令：
    添加 <内容>     例如：添加 买牛奶
    完成 <编号>     例如：完成 1
    删除 <编号>     例如：删除 2
    列出            显示所有任务
    统计            显示完成情况
    保存            立刻写入文件
    帮助            显示本帮助
    退出            保存并离开
""")
}

# ---------------- 主程序 ----------------
载入()
输出("═══════════════════════════")
输出("   待办清单（输入 帮助 看用法）")
输出("═══════════════════════════")
显示()

让 运行中 = 真
当 运行中 {
    写("\n> ")
    让 输入行 = 输入()
    如果 输入行 == 空 { 中断 }        # Ctrl+D 直接退出

    让 部分 = 输入行.去空白().分割(" ")
    让 命令 = 部分[0]
    让 参数 = 部分[1:].连接(" ")

    匹配 命令 {
        情形 "添加" {
            如果 参数 == "" { 输出("  要添加什么？") } 否则 { 添加(参数) }
        }
        情形 "完成" { 完成(数字(参数)) }
        情形 "删除" { 删除(数字(参数)) }
        情形 "列出" { 显示() }
        情形 "统计" {
            让 总数 = 任务表.长度
            让 完成数 = 过滤(t => t["完成"], 任务表).长度
            如果 总数 == 0 {
                输出("  还没有任务")
            } 否则 {
                输出("  完成 ${完成数}/${总数}（${整数(完成数 * 100 / 总数)}%）")
            }
        }
        情形 "保存" { 保存()  输出("  已保存到 ${文件路径}") }
        情形 "帮助" { 帮助() }
        情形 "退出" { 运行中 = 假  中断 }
        默认 { 输出("  看不懂「${命令}」，输入 帮助 看看用法") }
    }
}

保存()
输出("已保存，再见！")
