# 用例 06：抛出、捕获、最终、错误对象

# 基本捕获
让 捕获到了 = 假
尝试 {
    抛出 错误("出事了")
} 捕获 e {
    捕获到了 = 真
    断言(e.消息 == "出事了")
    断言(e.类型 == "错误")
}
断言(捕获到了)

# 最终块一定会执行
让 清理 = 假
尝试 {
    抛出 错误("x")
} 捕获 e {
    清理 = 假
} 最终 {
    清理 = 真
}
断言(清理)

# 没有异常时也会执行 最终
让 也执行了 = 假
尝试 {
    让 a = 1
} 最终 {
    也执行了 = 真
}
断言(也执行了)

# 捕获指定类型
函数 校验(年龄) {
    如果 年龄 < 0 { 抛出 错误("年龄不能为负", 类型="参数错误") }
    如果 年龄 > 150 { 抛出 错误("年龄太大", 类型="范围错误") }
    返回 真
}
让 命中类型 = ""
尝试 {
    校验(-1)
} 捕获 参数错误 as e {
    命中类型 = "参数错误"
} 捕获 范围错误 as e {
    命中类型 = "范围错误"
}
断言(命中类型 == "参数错误")

命中类型 = ""
尝试 {
    校验(200)
} 捕获 参数错误 as e {
    命中类型 = "参数错误"
} 捕获 范围错误 as e {
    命中类型 = "范围错误"
}
断言(命中类型 == "范围错误")

# 内置运行错误也能被捕获
让 内部错误 = ""
尝试 {
    让 x = 1 + 空
} 捕获 e {
    内部错误 = e.消息
}
断言(内部错误 != "")

# 抛出非错误对象
尝试 {
    抛出 "只是一个字符串"
} 捕获 e {
    断言(e == "只是一个字符串")
}

# 未捕获的异常会终止程序——这里用嵌套验证异常可以穿过函数调用
函数 内层() { 抛出 错误("来自内层") }
函数 中层() { 内层() }
让 消息 = ""
尝试 {
    中层()
} 捕获 e {
    消息 = e.消息
}
断言(消息 == "来自内层")

# 断言失败本身也是异常
让 断言失败 = 假
尝试 {
    断言(1 == 2, "一不等于二")
} 捕获 e {
    断言失败 = 真
}
断言(断言失败)

# 捕获后可以继续正常执行
让 后续 = 0
尝试 { 抛出 错误("忽略") } 捕获 e { 后续 = 1 }
让 x = 后续 + 1
断言(x == 2)

输出("用例 06 全部通过 ✔")
