# 用例 02：判断、循环、匹配、中断与继续

# if / elif / else
函数 分段(x) {
    如果 x < 0 { 返回 "负" }
    又如果 x == 0 { 返回 "零" }
    又如果 x < 10 { 返回 "小" }
    否则 { 返回 "大" }
}
断言(分段(-3) == "负")
断言(分段(0) == "零")
断言(分段(5) == "小")
断言(分段(50) == "大")

# 三元表达式
断言(1 > 2 ? "a" : "b" == "b")

# while
让 i = 0
让 和 = 0
当 i < 5 {
    和 += i
    i += 1
}
断言(和 == 10)

# while + break
让 j = 0
当 真 {
    j += 1
    如果 j == 3 { 中断 }
}
断言(j == 3)

# while + continue
让 奇数和 = 0
让 k = 0
当 k < 6 {
    k += 1
    如果 k % 2 == 0 { 继续 }
    奇数和 += k
}
断言(奇数和 == 9)      # 1 + 3 + 5

# for：列表 / 字符串 / 区间 / 字典
让 收集 = []
遍历 x 于 [1, 2, 3] { 收集.追加(x) }
断言(收集 == [1, 2, 3])

让 字符 = []
遍历 c 于 "abc" { 字符.追加(c) }
断言(字符 == ["a", "b", "c"])

让 区间和 = 0
遍历 n 于 1..4 { 区间和 += n }
断言(区间和 == 10)     # 1+2+3+4 闭区间

遍历 n 于 0..<3 { 区间和 += n }
断言(区间和 == 13)     # 再加 0+1+2

让 键值 = []
遍历 k, v 于 {"a": 1, "b": 2} { 键值.追加([k, v]) }
断言(键值.长度 == 2)

让 带下标 = []
遍历 下标, 值 于 ["甲", "乙"] { 带下标.追加([下标, 值]) }
断言(带下标 == [[0, "甲"], [1, "乙"]])

# 循环里中断
让 命中 = 空
遍历 n 于 范围(100) {
    如果 n == 7 { 命中 = n  中断 }
}
断言(命中 == 7)

# 匹配
函数 分类(x) {
    匹配 x {
        情形 0 { 返回 "零" }
        情形 1 { 返回 "一" }
        情形 其他 { 返回 "其它：${其他}" }
    }
}
断言(分类(0) == "零")
断言(分类(1) == "一")
断言(分类(9) == "其它：9")

输出("用例 02 全部通过 ✔")
