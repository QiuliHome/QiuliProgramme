# ==========================================================
#  10 文本处理：词频统计、格式化、凯撒密码、模板渲染
# ==========================================================

让 文章 = """
Qiuli 是一门为中文设计的编程语言。
Qiuli 的语法简单，读起来像句子。
用 Qiuli 写代码，就像在写笔记一样自然。
学习 Qiuli 只需要一个下午。
"""

# ---- 词频统计 ----
函数 分词(文本) {
    让 清洗 = 文本.替换("\n", " ").替换("。", " ").替换("，", " ")
    让 词表 = 清洗.分割(" ")
    返回 过滤(w => w.去空白() != "", 词表)
}

函数 统计词频(文本) {
    让 表 = {}
    遍历 词 于 分词(文本) {
        表[词] = 表.取(词, 0) + 1
    }
    返回 表
}

让 词频 = 统计词频(文章)
输出("词频统计：")
遍历 词, 次数 于 词频 {
    输出("  ${词} × ${次数}")
}

# 按出现次数排序
让 排行 = 排序(词频.项, p => -p[1])
输出("出现最多的是：${排行[0][0]}（${排行[0][1]} 次）")

# ---- 对齐输出一张表格 ----
函数 画表格(表头, 数据行) {
    让 列宽 = []
    遍历 i 于 范围(表头.长度) {
        让 最宽 = 表头[i].长度
        遍历 行 于 数据行 {
            如果 行[i].长度 > 最宽 { 最宽 = 行[i].长度 }
        }
        列宽.追加(最宽 + 2)
    }
    让 一行 = 分隔符 => {
        让 s = ""
        遍历 w 于 列宽 { s += 分隔符 * w }
        返回 s
    }
    输出(一行("─"))
    让 头 = ""
    遍历 i 于 范围(表头.长度) { 头 += 表头[i].居中(列宽[i]) }
    输出(头)
    输出(一行("─"))
    遍历 行 于 数据行 {
        让 线 = ""
        遍历 i 于 范围(行.长度) { 线 += 行[i].填充(列宽[i]) }
        输出(线)
    }
    输出(一行("─"))
}

画表格(
    ["姓名", "语文", "数学", "英语"],
    [["小明", "88", "92", "79"],
     ["小红", "95", "89", "94"],
     ["小刚", "72", "80", "85"]]
)

# ---- 凯撒密码：把每个字母向后移 k 位 ----
函数 凯撒加密(明文, 位移) {
    让 结果 = ""
    遍历 字符 于 明文 {
        让 码 = 字符码(字符)
        如果 码 >= 65 且 码 <= 90 {                 # 大写字母
            结果 += 码转字符((码 - 65 + 位移) % 26 + 65)
        } 又如果 码 >= 97 且 码 <= 122 {            # 小写字母
            结果 += 码转字符((码 - 97 + 位移) % 26 + 97)
        } 否则 {                                    # 其它字符原样保留
            结果 += 字符
        }
    }
    返回 结果
}

让 密文 = 凯撒加密("Hello Qiuli", 3)
输出("加密：", 密文)
输出("解密：", 凯撒加密(密文, -3))

# ---- 简易模板渲染：把 {{变量}} 换成值 ----
函数 渲染(模板, 数据) {
    让 结果 = 模板
    遍历 键, 值 于 数据 {
        结果 = 结果.替换("{{${键}}}", 字符串(值))
    }
    返回 结果
}

让 信 = 渲染(
    "亲爱的{{姓名}}：\n你在{{课程}}课上的成绩是 {{分数}} 分，排名第 {{名次}}。",
    {"姓名": "小明", "课程": "语文", "分数": 92, "名次": 3}
)
输出("")
输出(信)

# ---- 中文数字转阿拉伯数字（简单版）----
让 数字表 = {"零": 0, "一": 1, "二": 2, "三": 3, "四": 4,
             "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}
函数 中文转数字(文本) {
    让 结果 = 0
    遍历 字 于 文本 {
        如果 数字表.包含(字) {
            结果 = 结果 * 10 + 数字表[字]
        }
    }
    返回 结果
}
输出("二百五十三 →", 中文转数字("二百五十三"))
